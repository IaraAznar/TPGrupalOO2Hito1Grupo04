<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Festival" table="festival">
        <id column="idFestival" name="idFestival">
            <generator class="identity"/>
        </id>

        <property name="nombre" column="nombre" type="string" not-null="true"/>
        <property name="temporada" column="temporada" type="string" not-null="true"/>
        <property name="fechaInicio" column="fechaInicio" type="java.time.LocalDate" not-null="true"/>
        <property name="fechaFin" column="fechaFin" type="java.time.LocalDate" not-null="true"/>
        <property name="costoSuperficie" column="costoSuperficie" type="float" not-null="true"/>
        <property name="costoMontaje" column="costoMontaje" type="float" not-null="true"/>
        <property name="costoElectricidad" column="costoElectricidad" type="float" not-null="true"/>
        <property name="costoBase" column="costoBase" type="float" not-null="true"/>

        <!-- Relacion n:m con UnidadVenta -->
        <set name="unidadesDeVenta" table="festivalxunidadVenta" outer-join="true">
            <key column="idFestival"/>
            <many-to-many column="idUnidadVenta" class="datos.UnidadVenta"/>
        </set>
    </class>
</hibernate-mapping>